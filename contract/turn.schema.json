{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
        },
        "source": {
          "enum": [
            "voice",
            "drums",
            "kick",
            "snare",
            "percussion",
            "bass",
            "guitar",
            "keys",
            "synth",
            "strings",
            "brass",
            "mix",
            "other"
          ]
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 640
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 640
          },
          "minItems": 0,
          "maxItems": 12
        },
        "features": {
          "$ref": "#/$defs/features"
        },
        "previousGoal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/goal"
            }
          ]
        },
        "hasApplied": {
          "type": "boolean"
        },
        "hasPending": {
          "type": "boolean"
        },
        "appliedSettings": {
          "$ref": "#/$defs/settingsSummary"
        },
        "pendingSettings": {
          "$ref": "#/$defs/settingsSummary"
        },
        "previousResult": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "candidate",
                "keep",
                "clarify",
                "cancelled"
              ]
            },
            "before": {
              "$ref": "#/$defs/features"
            },
            "after": {
              "$ref": "#/$defs/features"
            },
            "midReductionDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "sideReductionDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "outcome",
            "midReductionDb",
            "sideReductionDb"
          ],
          "additionalProperties": false
        },
        "lastAction": {
          "enum": [
            "applied",
            "discarded",
            "undone"
          ]
        },
        "sourceOrigin": {
          "enum": [
            "host-name",
            "user",
            "unknown"
          ]
        },
        "auditioning": {
          "enum": [
            "applied",
            "pending"
          ]
        }
      },
      "required": [
        "version",
        "requestId",
        "source",
        "channels",
        "prompt",
        "history",
        "features",
        "previousGoal",
        "hasApplied",
        "hasPending"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "priorities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objective": {
                "enum": [
                  "stabilise",
                  "bringForward",
                  "air",
                  "preserveAttack",
                  "releaseTails",
                  "reduceAttack",
                  "easeCompression",
                  "bassWeight"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "required": [
              "objective",
              "intensity"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 8
        },
        "allowLR": {
          "type": "boolean"
        },
        "allowMS": {
          "type": "boolean"
        },
        "compensateGain": {
          "type": "boolean"
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "control": {
                "enum": [
                  "thresholdDb",
                  "ratio",
                  "attackMs",
                  "fastReleaseMs",
                  "slowReleaseMs",
                  "memory",
                  "kneeDb",
                  "hpfHz",
                  "airDb",
                  "makeupDb",
                  "inputTrimDb",
                  "outputGainDb",
                  "hpfOn",
                  "enabled",
                  "midSide"
                ]
              },
              "domain": {
                "enum": [
                  "both",
                  "main",
                  "side"
                ]
              },
              "change": {
                "enum": [
                  "set",
                  "increase",
                  "decrease"
                ]
              },
              "value": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "control",
              "domain",
              "change"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "priorities",
        "allowLR",
        "allowMS"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
            },
            "provider": {
              "enum": [
                "local-demo",
                "http",
                "claude"
              ]
            },
            "kind": {
              "enum": [
                "goal"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "goal": {
              "$ref": "#/$defs/goal"
            }
          },
          "required": [
            "version",
            "requestId",
            "provider",
            "kind",
            "text",
            "goal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
            },
            "provider": {
              "enum": [
                "local-demo",
                "http",
                "claude"
              ]
            },
            "kind": {
              "enum": [
                "question",
                "keep"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "version",
            "requestId",
            "provider",
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "settingsSummary": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "mono",
            "lr",
            "ms"
          ]
        },
        "inputTrimDb": {
          "type": "number",
          "minimum": -24,
          "maximum": 24
        },
        "outputGainDb": {
          "type": "number",
          "minimum": -24,
          "maximum": 24
        },
        "mid": {
          "type": "object",
          "properties": {
            "thresholdDb": {
              "type": "number",
              "minimum": -60,
              "maximum": 0
            },
            "ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 20
            },
            "airDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "makeupDb": {
              "type": "number",
              "minimum": -24,
              "maximum": 24
            },
            "attackMs": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 200
            },
            "fastReleaseMs": {
              "type": "number",
              "minimum": 10,
              "maximum": 3000
            },
            "slowReleaseMs": {
              "type": "number",
              "minimum": 100,
              "maximum": 15000
            },
            "memory": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "kneeDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "hpfHz": {
              "type": "number",
              "minimum": 20,
              "maximum": 500
            },
            "hpfOn": {
              "type": "boolean"
            }
          },
          "required": [
            "thresholdDb",
            "ratio",
            "airDb",
            "makeupDb"
          ],
          "additionalProperties": false
        },
        "side": {
          "type": "object",
          "properties": {
            "thresholdDb": {
              "type": "number",
              "minimum": -60,
              "maximum": 0
            },
            "ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 20
            },
            "airDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "makeupDb": {
              "type": "number",
              "minimum": -24,
              "maximum": 24
            },
            "attackMs": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 200
            },
            "fastReleaseMs": {
              "type": "number",
              "minimum": 10,
              "maximum": 3000
            },
            "slowReleaseMs": {
              "type": "number",
              "minimum": 100,
              "maximum": 15000
            },
            "memory": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "kneeDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "hpfHz": {
              "type": "number",
              "minimum": 20,
              "maximum": 500
            },
            "hpfOn": {
              "type": "boolean"
            }
          },
          "required": [
            "thresholdDb",
            "ratio",
            "airDb",
            "makeupDb"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "mode",
        "inputTrimDb",
        "outputGainDb",
        "mid",
        "side"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "peakDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "rmsDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "phraseSpreadDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "crestDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "highRatioDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "midHighEnergy": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "sideHighEnergy": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "referenceContrastDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "referenceOverlap": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "attackDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "decayDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "monoFoldDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "usable": {
          "type": "boolean"
        },
        "hasReference": {
          "type": "boolean"
        },
        "hasReferenceSignal": {
          "type": "boolean"
        },
        "highSpreadDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "midEnergy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "sideEnergy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "sideTailRatioDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "highPulseCorrelation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "clippedFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "monitorDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "activeWindows": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "phraseWindows": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "lowRatioDb": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
